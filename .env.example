# Google Gemini API Key (Required for AI market analysis)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Notifications (Optional / Recommended)
# 1. Create bot via @BotFather to get Token
# 2. Get your Chat ID via @userinfobot or channel ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Vercel Cron Security Secret (Optional for securing /api/cron)
CRON_SECRET=your_custom_cron_secret_here

# Optional: Massive Data API Key (if you have one from massive.com)
MASSIVE_API_KEY=your_massive_api_key_here
